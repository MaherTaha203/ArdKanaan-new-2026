# متغيّرات بيئة أرض كنعان — نموذج فقط. انسخه إلى .env.local واملأ القيم.
# لا تضع أسرارًا في Git. لم يُنشأ مشروع Supabase بعد؛ القيم أدناه placeholders.

# عنوان مشروع Supabase والمفتاح العام (آمن للعميل، لا يغني عن RLS والتحقق الخادمي).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# المفتاح السري (service_role) — خادمي فقط، لا يُضمَّن في العميل إطلاقًا.
# يُستخدم لاحقًا في مكوّن النسخ الاحتياطي الموثوق (Edge Function)، لا في تطبيق الويب.
# SUPABASE_SERVICE_ROLE_KEY=
